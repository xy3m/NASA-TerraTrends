# Geo-Iris Phase 2 FastAPI Backend Configuration
# Copy to .env and populate optional NASA credentials for live authenticated feeds.
# When omitted, keyless endpoints (EONET, ASF Search, CMR, POWER, file uploads) work
# normally and authenticated workflows transparently return labeled synthetic_demo data.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# NASA FIRMS MAP_KEY (free registration at https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_MAP_KEY=

# NASA Earthdata Login (EDL) for earthaccess, AppEEARS, GES DISC, PO.DAAC, NSIDC
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
